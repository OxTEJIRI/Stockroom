# Set automatically when you connect a Vercel Blob store to the project.
BLOB_READ_WRITE_TOKEN=
# "private" (default) or "public" — match the access mode of your Blob store.
BLOB_ACCESS=private

# Public URL of the site. Optional on Vercel (falls back to the production domain).
SITE_URL=

# x402 settings. Defaults: Base mainnet, PayAI facilitator (no API key).
X402_NETWORK=eip155:8453
X402_FACILITATOR_URL=https://facilitator.payai.network

# Optional: require this code to publish (anti-spam during judging).
PUBLISH_CODE=
# Required for the takedown route.
ADMIN_KEY=
